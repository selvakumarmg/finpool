{
  "expo": {
    "name": "FinPool",
    "slug": "finpool",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-logo.png",
    "scheme": "finpool",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.selvakumar.finpool"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a0b2e",
        "foregroundImage": "./assets/images/app-logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "dev.selvakumar.finpool"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro",
      "name": "FinPool - Track Expenses & Savings",
      "shortName": "FinPool",
      "lang": "en",
      "scope": "/",
      "themeColor": "#7C3AED",
      "backgroundColor": "#1a0b2e",
      "description": "Track your expenses, manage loans, and achieve your savings goals with FinPool",
      "dir": "auto",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/",
      "preferRelatedApplications": false,
      "config": {
        "firebase": {
          "apiKey": "AIzaSyD2eJC9zxzAi-O3i9fZKYqYtKZpE2eStcE",
          "authDomain": "finpool-e272b.firebaseapp.com",
          "projectId": "finpool-e272b",
          "storageBucket": "finpool-e272b.firebasestorage.app",
          "messagingSenderId": "532732415001",
          "appId": "1:532732415001:web:a50be96e7e613d36d36e88"
        }
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8a86950d-d99a-4042-b136-5a6acfaecafd"
      }
    }
  }
